# === AlgoForge Secrets ===
# Copy to .env and fill in real values. Never commit .env.

# GitHub Personal Access Token (classic) with `repo` scope
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Required for non-local deployment) API key to secure the web UI mutation endpoints
ALGOFORGE_API_KEY=my_secure_api_key_123

# Target streak repo (owner/name)
GITHUB_REPO=Aayush-pixel29/leetcode
GITHUB_BRANCH=main

# Your LeetCode profile username (from https://leetcode.com/u/pYwmntvkNk/)
LEETCODE_USERNAME=pYwmntvkNk

# Optional: session cookie if GraphQL needs auth for private fields
# LEETCODE_SESSION=

# LLM backend: gemini | ollama | openai | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Required for Gemini (Get free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ollama base URL (default local)
OLLAMA_BASE_URL=http://localhost:11434

# === Gmail Notifications ===
# Required for daily email reminders. Must use an App Password.
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=

# Dry-run: solve + write locally, skip GitHub push
DRY_RUN=false
