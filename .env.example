# === AlgoForge Secrets ===
# Copy to .env and fill in real values. Never commit .env.

# GitHub Personal Access Token (classic) with `repo` scope
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target streak repo (owner/name)
GITHUB_REPO=Aayush-pixel29/leetcode
GITHUB_BRANCH=main

# Your LeetCode profile username (from https://leetcode.com/u/pYwmntvkNk/)
LEETCODE_USERNAME=pYwmntvkNk

# Optional: session cookie if GraphQL needs auth for private fields
# LEETCODE_SESSION=

# LLM backend: ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3

# Only needed if LLM_PROVIDER is openai / anthropic / gemini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=          # Get free key: https://aistudio.google.com/apikey

# Ollama base URL (default local)
OLLAMA_BASE_URL=http://localhost:11434

# Dry-run: solve + write locally, skip GitHub push
DRY_RUN=false
